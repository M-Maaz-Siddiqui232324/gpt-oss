# Docker Environment Variables
# Use this file when deploying with Docker

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_db
POSTGRES_SCHEMA=chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# Ollama LLM
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gpt-oss:20b

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=change-this-in-production-use-secrets-token-urlsafe-32

# Default Client
DEFAULT_CLIENT_ID=1
